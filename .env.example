# Copy to .env for local development. On Cloud Run, put the secrets in Secret Manager.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/govcheckin
PORT=8080

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
# Set ONCE and never change: every stored ID hash depends on it
ID_HASH_SECRET=
QR_SIGNING_SECRET=

# Optional
APP_TIMEZONE=Africa/Gaborone
TOKEN_TTL=8h
# Fixed password for demo staff accounts (otherwise a random one is printed to seed-output/credentials.txt)
SEED_PASSWORD=

# Tests wipe this database. Never point it at real data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/govcheckin_test
